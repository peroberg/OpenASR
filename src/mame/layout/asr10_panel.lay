<mamelayout version="2">

	<element name="vfd0" defstate="0">
		<led14segsc>
			<color red="0.45" green="1.0" blue="0.95" />
		</led14segsc>
	</element>

	<element name="underline" defstate="0">
		<rect state="0"><color red="0.06" green="0.12" blue="0.10" /></rect>
		<rect state="1"><color red="0.45" green="1.00" blue="0.95" /></rect>
	</element>

	<!-- Del 4 (docs/asr10/investigations/annunciator-bit-probe.md), Del 5
	     (docs/asr10/investigations/panel-button-and-transport-map.md):
	     raw bit-level view of the 5 annunciator registers ($77 to $7b),
	     8 bits each. `[OPEN]`: only asr10_instlamp0 (register $77 bit 0)
	     has a confirmed meaning, and gets its own labeled, bright-amber
	     `instlamp` below. The other 39 bits are `annlamp`, deliberately
	     dim, desaturated grey-amber even when lit, and explicitly
	     labelled "OPEN" in the view, so an unidentified bit reads as
	     unknown at a glance, not as confirmed information. A lit lamp
	     without a known meaning is worse than no lamp at all; do not
	     brighten this color or drop the label without first
	     establishing what the bit means. -->
	<element name="annlamp" defstate="0">
		<rect state="0"><color red="0.10" green="0.09" blue="0.08" /></rect>
		<rect state="1"><color red="0.45" green="0.38" blue="0.28" /></rect>
	</element>

	<element name="annlamp_open_label">
		<text string="OPEN, UNKNOWN MEANING"><color red="0.50" green="0.42" blue="0.30" /></text>
	</element>

	<element name="instlamp" defstate="0">
		<rect state="0"><color red="0.10" green="0.08" blue="0.05" /></rect>
		<rect state="1"><color red="1.00" green="0.85" blue="0.20" /></rect>
	</element>

	<element name="instlamp_label">
		<text string="INST 1"><color red="0.55" green="0.55" blue="0.45" /></text>
	</element>

